{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xenon",
  "version": "0.1.0",
  "identifier": "com.xenon.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Xenon",
        "width": 200,
        "height": 200,
        "x": 50,
        "y": 50,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "providerShortName": "XENON"
    }
  }
}
