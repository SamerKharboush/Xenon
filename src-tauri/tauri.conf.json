{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xenon",
  "version": "0.1.0",
  "identifier": "com.xenon.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xenon",
        "width": 320,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "backgroundColor": [0, 0, 0, 0]
      },
      {
        "label": "settings",
        "title": "Xenon Settings",
        "url": "settings.html",
        "width": 650,
        "height": 750,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      },
      {
        "label": "onboarding",
        "title": "Xenon — Permission Setup",
        "url": "onboarding.html",
        "width": 520,
        "height": 440,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "providerShortName": "XENON"
    }
  }
}