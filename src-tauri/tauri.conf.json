{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xenon",
  "version": "0.3.5",
  "identifier": "com.xenon.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Xenon",
        "width": 320,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "acceptFirstMouse": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/64x64.png"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Xenon contributors",
    "shortDescription": "Local-first desktop companion",
    "longDescription": "Xenon is a lightweight, local-first desktop companion for macOS: a menu-bar pet that listens for voice commands, runs a ReAct agent loop, and controls your computer — all in Rust.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist",
      "infoPlist": "./Info.plist",
      "providerShortName": "XENON",
      "dmg": {
        "background": "icons/dmg-bg.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}